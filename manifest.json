{
  "manifest_version": 3,
  "name": "HN Jev Sorter",
  "version": "1.0.0",
  "description": "Sort Hacker News comments into buckets you define, in real time, with Jev by TypeSafe.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://news.ycombinator.com/*",
    "https://api.typesafe.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Sort HN comments with Jev"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
